--config
codegen=latest
file=single
types=windows
--generate
file-scoped-namespaces
guid-member
marker-interfaces
macro-bindings
generated-code=none
com-proxies=false
enum-operators=false
unmanaged-constants
--namespace
Crystal.Interop
--with-access-specifier
*=Internal
--remap
wchar_t=char
tagRECT=RECT
tagPOINT=POINT
_LUID=LUID
_LARGE_INTEGER=LARGE_INTEGER
_ULARGE_INTEGER=ULARGE_INTEGER
_FILETIME=FILETIME
tagSTATSTG=STATSTG
_SECURITY_ATTRIBUTES=SECURITY_ATTRIBUTES
_REASON_CONTEXT=REASON_CONTEXT
waveformat_tag=WAVEFORMAT
pcmwaveformat_tag=PCMWAVEFORMAT
tWAVEFORMATEX=WAVEFORMATEX
_D3D_CBUFFER_TYPE=D3D_CBUFFER_TYPE
_D3D_INCLUDE_TYPE=D3D_INCLUDE_TYPE
_D3D_PARAMETER_FLAGS=D3D_PARAMETER_FLAGS
_D3D_SHADER_CBUFFER_FLAGS=D3D_SHADER_CBUFFER_FLAGS
_D3D_SHADER_INPUT_FLAGS=D3D_SHADER_INPUT_FLAGS
_D3D_SHADER_INPUT_TYPE=D3D_SHADER_INPUT_TYPE
_D3D_SHADER_MACRO=D3D_SHADER_MACRO
_D3D_SHADER_VARIABLE_CLASS=D3D_SHADER_VARIABLE_CLASS
_D3D_SHADER_VARIABLE_FLAGS=D3D_SHADER_VARIABLE_FLAGS
_D3D_SHADER_VARIABLE_TYPE=D3D_SHADER_VARIABLE_TYPE
_D3D12_FUNCTION_DESC=D3D12_FUNCTION_DESC
_D3D12_LIBRARY_DESC=D3D12_LIBRARY_DESC
_D3D12_PARAMETER_DESC=D3D12_PARAMETER_DESC
_D3D12_SHADER_BUFFER_DESC=D3D12_SHADER_BUFFER_DESC
_D3D12_SHADER_DESC=D3D12_SHADER_DESC
_D3D12_SHADER_INPUT_BIND_DESC=D3D12_SHADER_INPUT_BIND_DESC
_D3D12_SHADER_TYPE_DESC=D3D12_SHADER_TYPE_DESC
_D3D12_SHADER_VARIABLE_DESC=D3D12_SHADER_VARIABLE_DESC
_D3D12_SIGNATURE_PARAMETER_DESC=D3D12_SIGNATURE_PARAMETER_DESC
_D3DCOLORVALUE=D3DCOLORVALUE
_DXGI_OFFER_RESOURCE_FLAGS=DXGI_OFFER_RESOURCE_FLAGS
_DXGI_OFFER_RESOURCE_PRIORITY=DXGI_OFFER_RESOURCE_PRIORITY
_DXGI_RECLAIM_RESOURCE_RESULTS=DXGI_RECLAIM_RESOURCE_RESULTS
--additional
-Wno-everything
-DWIN32_LEAN_AND_MEAN
-DNOMINMAX
-DINITGUID
